# Vercel (Project → Settings → Environment Variables)
# NEXT_PUBLIC_* must be set for Production before deploy — they are baked in at build time.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Next.js / Vercel (server-only)
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=https://your-app.vercel.app/api/spotify/callback

# Convex dashboard (npx convex env set NAME value)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=https://your-app.vercel.app/api/spotify/callback
# GOOGLE_BOOKS_API_KEY=
