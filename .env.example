# Vercel (Project → Settings → Environment Variables)
# NEXT_PUBLIC_* must be set for Production before deploy — they are baked in at build time.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Next.js / Vercel (server-only) — use your real Vercel URL in production, not 127.0.0.1
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=https://your-app.vercel.app/api/spotify/callback

# Local development only:
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# Convex dashboard (npx convex env set NAME value) — same production redirect URI as Vercel
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=https://your-app.vercel.app/api/spotify/callback
# GOOGLE_BOOKS_API_KEY=

# Apple Music playlist export (Convex env). Same $99 Apple Developer Program — no extra Apple fee.
# Create a MusicKit key in Certificates, Identifiers & Profiles, then:
# APPLE_MUSIC_TEAM_ID=
# APPLE_MUSIC_KEY_ID=
# APPLE_MUSIC_PRIVATE_KEY=   # .p8 contents; use \n for newlines
# APPLE_MUSIC_STOREFRONT=us  # optional fallback if the user storefront cannot be read
# APPLE_MUSIC_ORIGIN=https://your-app.vercel.app,http://127.0.0.1:3000

